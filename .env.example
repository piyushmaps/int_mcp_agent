# Copy to .env. The default demo works without API keys or external services.
APP_ENV=development
AUTH_MODE=demo
DEMO_TOKEN=local-demo-token
MODEL_MODE=demo
BOOTSTRAP_DEMO=true
MCP_TRANSPORT=stdio
REQUEST_TIMEOUT=30
SESSION_TTL_SECONDS=3600
MAX_TOOL_CALLS=8

# Optional model-backed planner, specialists and evidence-only writer.
# Enable only after approving your organization's data processing by this provider.
# MODEL_MODE=openai
# APPROVED_MODEL_PROCESSING=true
# OPENAI_API_KEY=replace-locally
# OPENAI_MODEL=gpt-4.1-mini

# Optional learned embeddings. A new model requires a new index directory.
# EMBEDDING_MODE=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# DATA_DIR=data/runtime-openai
# VECTOR_BACKEND=faiss
# OpenSearch also requires the search extra and an approved HTTPS cluster:
# VECTOR_BACKEND=opensearch
# APPROVED_REMOTE_INDEXING=true
# OPENSEARCH_ENDPOINT=https://search.example.com
# OPENSEARCH_USERNAME=atlas
# OPENSEARCH_PASSWORD=replace-locally

# Real local protocol over HTTP instead of child processes. Start both MCP servers first.
# MCP_TRANSPORT=http
# JIRA_MCP_URL=http://127.0.0.1:8011/mcp
# SLACK_MCP_URL=http://127.0.0.1:8012/mcp
# MCP_TOKEN=local-mcp-token

# Optional JWT validation for a local integration test (not a production sign-in UI).
# AUTH_MODE=jwt
# JWT_ISSUER=https://identity.example.com/
# JWT_AUDIENCE=engineering-atlas
# JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# JWT_REQUIRED_GROUP=engineering-atlas
# JWT_ADMIN_GROUP=engineering-atlas-admin

