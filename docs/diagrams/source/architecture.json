  "cards": [
    {
      "dot": "rose",
      "title": "Release gate",
      "items": [
        "Every claim must be an exact excerpt of cited evidence",
        "Revocation rechecked before and after memory save",
        "Raw drafts never stream; SSE sends progress only"
      ]
    },
    {
      "dot": "amber",
      "title": "Bounds",
      "items": [
        "30 s deadline, 8 tool calls, 2 concurrent reads",
        "One refinement round when evidence is empty",
        "Evidence capped at 12 items, newest first"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ingestion",
      "items": [
        "Screen before embedding; injection quarantines",
        "Generation check + atomic active-version swap",
        "Prune only after a complete scoped enumeration"
      ]
    },
    {
      "dot": "slate",
      "title": "Process-local state",
      "items": [
        "Sessions, admission and telemetry live in memory",
        "Restart drops them; replicas would not share them"
      ]
    }
  ]
