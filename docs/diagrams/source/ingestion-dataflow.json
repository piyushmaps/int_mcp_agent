  "cards": [
    {
      "dot": "emerald",
      "title": "Publication contract",
      "items": [
        "Old version stays live until the new one commits",
        "Generation mismatch raises PublicationConflict",
        "Older numeric revision can never replace newer"
      ]
    },
    {
      "dot": "rose",
      "title": "Restriction wins",
      "items": [
        "company_wide=false revokes before any screening",
        "Revoked docs need a strictly newer revision",
        "Seed data never resurrects a revoked doc"
      ]
    },
    {
      "dot": "amber",
      "title": "Pruning",
      "items": [
        "Only after a complete, scoped enumeration",
        "Any failed file marks the scan incomplete"
      ]
    }
  ]
