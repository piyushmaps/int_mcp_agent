  "cards": [
    {
      "dot": "emerald",
      "title": "Outcomes",
      "items": [
        "answered: claims pass, no limitations",
        "partial: claims pass, any limitation present",
        "insufficient_evidence or unavailable: no claims",
        "blocked: gate failed or evidence changed"
      ]
    },
    {
      "dot": "amber",
      "title": "Bounds",
      "items": [
        "asyncio.timeout 30 s around the whole graph",
        "recursion_limit 16; at most one refinement",
        "Shared CallBudget: 8 reads, 2 concurrent"
      ]
    },
    {
      "dot": "rose",
      "title": "Never streamed",
      "items": [
        "Progress events carry stage names only",
        "Draft text is released only after validation"
      ]
    }
